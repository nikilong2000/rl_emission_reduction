@inproceedings{hagenbucher_initialization_2023,
	title = {Initialization of {LSTM} {Networks} for {Data}-{Driven} {Modeling} {Based} on {Real}-{Driving} {Data}},
	url = {https://ieeexplore.ieee.org/document/10275195},
	doi = {10.1109/ICAC57885.2023.10275195},
	abstract = {Modeling transient systems is challenging regardless of the conceptual approach and requires the use of case-specific adaptations for a successful implementation. The conventional representation in the form of a white-box approach using physical simulation models can determine labels very well for short prediction periods. Unfortunately, this capability cannot be extended to longer prediction periods, so an alternative approach is essential. With the increasingly improving prediction capabilities of neural networks due to better databases and more powerful computing systems, transient systems can be predicted remarkably well for extended periods. However, previously used methods show comparatively high deviations in the initial phases. This paper introduces an initialization method for recurrent neural networks that counteracts this problem. This method has been developed independently of the initialization methods already discussed in the literature. Consequently, the resulting advantages are briefly explained. The proposed initialization method is validated with the sub-models of the digital twin of a power-split hybrid vehicle powertrain.},
	urldate = {2026-04-20},
	booktitle = {2023 28th {International} {Conference} on {Automation} and {Computing} ({ICAC})},
	author = {Hagenbucher, Timo and Milojevic, Sasa and Grill, Michael and Kulzer, André Casal},
